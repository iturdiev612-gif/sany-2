# SHA-256 of a strong admin password. Never use the plaintext password here.
ADMIN_PASSWORD_SHA256=
PORT=4173
# Optional on Vercel: durable admin, catalog changes and server-side enquiries.
# Public catalog and WhatsApp booking work without these.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Use a separate database/namespace for preview deployments.
SANY_STORAGE_PREFIX=sany:
